# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
dist/
**/dist/
*.tsbuildinfo

# ...but test fixture nodes may legitimately contain a dist/ folder as data
# (e.g. a pack's downloadable build that the scanner checksums). Keep those.
!**/test/fixtures/**/dist/
!**/test/fixtures/**/dist/**

# Test / coverage
coverage/
.vitest/

# Node build artifacts for archetype example nodes (regenerable)
examples/**/dist/
archetypes/**/dist/

# OS / editor cruft
.DS_Store
Thumbs.db

# Personal editor/agent tooling
.cursor/
.claude/

# Local env
.env
.env.*
!.env.example

# Archetypes are copied into the CLI at pack time (source of truth is /archetypes);
# the bundled 'blank' template stays tracked.
packages/cli/templates/*
!packages/cli/templates/blank
!packages/cli/templates/blank/**
