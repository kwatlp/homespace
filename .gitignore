# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
dist/
**/dist/
*.tsbuildinfo

# ...but test fixture homespaces may legitimately contain a dist/ folder as data
# (e.g. a pack's downloadable build that the scanner checksums). Keep those.
!**/test/fixtures/**/dist/
!**/test/fixtures/**/dist/**

# Test / coverage
coverage/
.vitest/

# Node build artifacts for archetype example homespaces (regenerable)
examples/**/dist/
archetypes/**/dist/

# OS / editor cruft
.DS_Store
Thumbs.db

# Personal editor/agent tooling
.cursor/
.claude/

# Local env
.env
.env.*
!.env.example

# Tier-2 daemon config — may hold the operator key or scoped keys.
# Prefer HOMESPACE_OPERATOR_KEY in the environment (TDD §9.2, §12).
homespace.serve.json
**/homespace.serve.json

# Daemon upload spool (inside a served homespace root)
.uploads/
**/.uploads/

# Archetypes are copied into the CLI at pack time (source of truth is /archetypes);
# the bundled 'blank' template stays tracked.
packages/cli/templates/*
!packages/cli/templates/blank
!packages/cli/templates/blank/**

# Scratch homespace scaffolded by `homespace init` while testing
/my-homespace/
